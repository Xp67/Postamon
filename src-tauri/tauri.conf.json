{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Postamon",
  "version": "2.0.0",
  "identifier": "it.dimensionesalotto.postamon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Postamon",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 600,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "Dimensione Salotto",
    "shortDescription": "Posta e chat interna",
    "copyright": "Dimensione Salotto",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Italian"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEEwREZGODI4MTY4RDgxRUUKUldUdWdZMFdLUGpmb0Z1clV4TWNNcjRDVTNwSGFuQ3hkZnhOSFN3azhmbHFxU3dxS3lhUlh6OW8K",
      "requireSignedVersion": true,
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
